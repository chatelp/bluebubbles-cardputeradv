# ------------------------------------------------------ sorties générées
# Les cartes de design/ SONT versionnées (elles documentent le langage
# visuel), mais jamais une capture prise sur l'appareil : le portail web
# rend le formulaire PRÉREMPLI avec le WiFi et les mots de passe réels.
design/build/
design/portail/apercu.html
# Les captures BRUTES du simulateur sont jetables (regénérables en une
# seconde) ; ce qui est publié vit dans docs/images/ et docs/m5burner/,
# produit par scripts/readme_images.py et scripts/make_store_images.py.
captures/

# ------------------------------------------------ travail hors dépôt
private/

# ----------------------------------------------------- réglages locaux
.claude/settings.local.json

# ------------------------------------------------------------- secrets
# Le seul secret du projet est le mot de passe du serveur BlueBubbles : il
# vit en NVS sur l'appareil, jamais ici (garde-fou de CLAUDE.md). Ces
# règles protègent d'un ajout futur par inadvertance.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
*.ppk
secrets.json
credentials.json
service-account*.json
.netrc
